# Local defaults work without any secrets:
# CONTEXTOS_GEMINI_ENABLED=false
CONTEXTOS_PERSISTENCE=memory

# Enable Gemini Developer API analysis.
# Create an API key in Google AI Studio, then set:
GOOGLE_API_KEY=
CONTEXTOS_GEMINI_ENABLED=true
CONTEXTOS_GEMINI_MODEL=gemini-3.5-flash-lite

# Enable Firestore persistence.
# Create a Firebase/GCP project with Firestore Standard, then set:
# CONTEXTOS_PERSISTENCE=firestore
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# CORS for local extension/web testing.
CONTEXTOS_ALLOWED_ORIGINS=http://localhost:5173,chrome-extension://*
